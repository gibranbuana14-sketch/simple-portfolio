                            <span class="text-3xl">💡</span>
                            <p class="font-semibold mt-2">Pemecahan Masalah</p>
                        </div>
                        <div class="bg-white p-4 rounded-lg shadow-sm text-center">
                            <span class="text-3xl">🗣️</span>
                            <p class="font-semibold mt-2">Komunikasi Efektif</p>
                        </div>
                        <div class="bg-white p-4 rounded-lg shadow-sm text-center">
                            <span class="text-3xl">🚀</span>
                            <p class="font-semibold mt-2">Cepat Belajar & Adaptif</p>
